{
  "name": "rame",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 5500",
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src next.config.ts postcss.config.mjs tsconfig.json package.json",
    "format:check": "prettier --check src next.config.ts postcss.config.mjs tsconfig.json package.json"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.6.2"
  }
}
